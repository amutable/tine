"""The alpm (pacman) native package system and its driver bundle."""

load("//package:system.bzl", "package_system")
load("//python:defs.bzl", "python")

# Host tools bootstrap the box; remaining drivers run inside it.

# alpm's formats, read and written without the library, plus the library that resolves against
# them. The host-side drivers below use only the first half; see alpm.py.
python.library(name = "alpm", srcs = ["alpm.py"], deps = ["//:util"])

python.binary(
    name = "extract",
    main = "extract.py",
    deps = [":alpm", "//package:extractor"],
)

python.binary(
    name = "install",
    main = "install.py",
    deps = [":alpm", "//:util", "//package:installer"],
)

# The capture driver implements the terminal-image contract, so it takes that library.
python.binary(
    name = "pkgdb",
    main = "pkgdb.py",
    deps = [
        ":alpm",
        "//:specs",
        "//:util",
        "//archive:tar",
        "//image:finalize",
    ],
)
python.binary(name = "index", main = "index.py", deps = [":alpm", "//:specs", "//:util"])
python.binary(
    name = "plan",
    main = "plan.py",
    deps = [
        ":alpm",
        "//:specs",
        "//:util",
        "//package:href",
        "//package:transaction",
        "//uapi16:storage",
    ],
)

python.binary(
    name = "snapshot",
    main = "snapshot.py",
    deps = [":alpm", "//:util", "//package:href", "//package:snapshotter"],
)

python.library(name = "gnupg", srcs = ["gnupg.py"])

python.binary(
    name = "keyring",
    main = "keyring.py",
    deps = [":gnupg", "//:specs", "//:util"],
)

python.binary(
    name = "verify",
    main = "verify.py",
    deps = [":alpm", ":gnupg", "//:specs", "//:util", "//package:snapshotter"],
)

# `build` stays unset: Arch has no makepkg rule here yet.
package_system(
    name = "package_system",
    arch_schema = "pacman",
    # alpm keeps a directory of per-package entries, so a capture of it is an archive.
    database_format = "tar.zst",
    # Keep in sync with alpm.py's DBPATH, which Starlark cannot read.
    database_paths = ["var/lib/pacman"],
    # pacman reads the pinned databases directly, so there is nothing to convert in advance.
    solver_cache = False,
    extract = ":extract",
    index = ":index",
    install = ":install",
    keyring = ":keyring",
    # The database carries each package's signature.
    metadata_vouches = True,
    verify = ":verify",
    # Arch has served zstd for years, so that is what a selected package is named with; an older
    # compressor still in a pinned repository is only recognized (alpm.is_package), never named.
    package_suffix = ".pkg.tar.zst",
    pkgdb = ":pkgdb",
    plan = ":plan",
    snapshot = ":snapshot",
    visibility = ["PUBLIC"],
)

python.test(
    name = "plan-test",
    box = "//tools:dev.box",
    srcs = ["alpm.py", "plan.py", "plan_test.py"],
    deps = ["//:specs", "//:util", "//package:href", "//package:transaction", "//uapi16:storage"],
)

python.test(
    name = "test",
    box = "//tools:dev.box",
    deps = ["//:specs", "//:util", "//package:snapshotter"],
    srcs = [
        "alpm.py",
        "alpm_test.py",
        "gnupg.py",
        "gnupg_test.py",
        "keyring.py",
        "verify.py",
        "verify_test.py",
    ],
)
