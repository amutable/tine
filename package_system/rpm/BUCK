"""The RPM native package system and its driver bundle."""

load("//package:system.bzl", "package_system")
load("//python:defs.bzl", "python")

# The drivers that import libdnf5, createrepo_c or rpm are type-checked against the dev box.
_BOX = "tine//tools:dev.box"

python.library(name = "rpmfile", srcs = ["rpmfile.py"], deps = ["//:util"])

python.binary(
    name = "extract",
    main = "extract.py",
    deps = [":rpmfile", "//archive:cpio", "//package:extractor"],
)

python.library(name = "macros", srcs = ["macros.py"], boxes = [_BOX])

python.binary(name = "install", main = "install.py", boxes = [_BOX], deps = [":macros", "//:util", "//package:installer"])

# The capture driver implements the terminal-image contract, so it takes that library.
python.binary(name = "pkgdb", main = "pkgdb.py", deps = ["//:specs", "//:util", "//image:finalize"])

python.binary(
    name = "createrepo",
    main = "createrepo.py",
    boxes = [_BOX],
    deps = ["//:specs", "//:util"],
)

python.binary(
    name = "plan",
    main = "plan.py",
    boxes = [_BOX],
    deps = [":macros", "//:specs", "//:util", "//package:transaction", "//rootfs:rootfs"],
)

python.library(name = "rpmbuild", srcs = ["rpmbuild.py"], deps = ["//:util", "//package:builder"])

python.test(
    name = "rpmbuild-test",
    srcs = ["rpmbuild.py", "rpmbuild_test.py"],
    deps = ["//:util", "//package:builder"],
)

python.binary(name = "build", main = "build.py", deps = [":rpmbuild", "//:specs", "//:util", "//package:builder", "//package:subpackage"])

python.test(
    name = "build-test",
    box = _BOX,
    srcs = ["build.py", "build_test.py"],
    deps = [":rpmbuild", "//:specs", "//:util", "//package:builder", "//package:subpackage"],
)

python.binary(
    name = "buildrequires",
    main = "buildrequires.py",
    deps = [":rpmbuild", "//:specs", "//:util", "//package:builder", "//rootfs:rootfs"],
    visibility = ["PUBLIC"],
)

# The test queries specs with the rpmbuild of the dev box.
python.test(
    name = "buildrequires-test",
    box = _BOX,
    srcs = ["buildrequires.py", "buildrequires_test.py"],
    deps = [":rpmbuild", "//:specs", "//:util", "//package:builder", "//rootfs:rootfs"],
)

python.binary(
    name = "snapshot",
    deps = ["//:util", "//package:href", "//package:snapshotter"],
    main = "snapshot.py",
)

python.library(name = "rpmkeys", srcs = ["rpmkeys.py"])

python.binary(
    name = "keyring",
    main = "keyring.py",
    boxes = [_BOX],
    deps = [":rpmkeys", "//:specs", "//:util"],
)

python.binary(
    name = "verify",
    main = "verify.py",
    boxes = [_BOX],
    deps = [":rpmkeys", "//:specs", "//:util"],
)

python.test(
    name = "plan-test",
    box = _BOX,
    srcs = ["createrepo.py", "plan.py", "plan_test.py"],
    deps = [":macros", "//:specs", "//:util", "//package:transaction", "//rootfs:rootfs"],
)

python.test(
    name = "test",
    box = _BOX,
    srcs = ["keyring.py", "rpmkeys.py", "verify.py", "verify_test.py"],
    deps = ["//:specs", "//:util"],
)

package_system(
    name = "package_system",
    arch_schema = "rpm",
    extract = ":extract",
    snapshot = ":snapshot",
    install = ":install",
    pkgdb = ":pkgdb",
    index = ":createrepo",
    package_suffix = ".rpm",
    plan = ":plan",
    build = ":build",
    keyring = ":keyring",
    verify = ":verify",
    # rpm keeps one sqlite database, so a capture of it is that file.
    database_format = "sqlite",
    # Keep in sync with install.py's DBPATH, which Starlark cannot read.
    database_paths = ["usr/lib/sysimage/rpm"],
    visibility = ["PUBLIC"],
)
