"""RPM package-build examples and their end-to-end assertions."""

load("@tine//box:defs.bzl", "box")
load("@tine//git:defs.bzl", "git")
load("@tine//image:defs.bzl", "image")
load("@tine//package:defs.bzl", "package")
load("@tine//package_system/rpm:defs.bzl", "rpm")

_DISTRO = "catalog//:fedora.rawhide.distribution"

_BUILDROOT = "catalog//:fedora.rawhide.buildroot"

# The checks query the packages with rpm. The root box of the buildroot's release contains rpm, and the dev
# box contains it only when it builds from a Fedora release.
_CHECK_BOX = "catalog//:fedora.rawhide.box"

# `_CONTAINS` fails unless the rpm in its first argument contains /usr/share/tine-package/<marker> for each
# further argument.
_CONTAINS = 'files=$(rpm -qpl "$1") || exit 1; shift; for marker; do echo "$files" | grep -qx "/usr/share/tine-package/$marker" || { echo "missing $marker"; exit 1; }; done'

git.checkout(name = "hello.source")

# rpm.branch() derives buildroot_packages from the BuildRequires of every architecture. A package can then
# have buildroot_packages and no build_requires on the architecture that it builds for.
rpm.package(
    name = "hello-buildroot-packages",
    distro = _DISTRO,
    package = "hello",
    spec = "hello/hello.spec",
    buildroot = _BUILDROOT,
    buildroot_packages = [":hello-archive"],
    release = "1",
    source_date_epoch = 1754006400,
    subpackages = ["hello"],
)

box.sh_test(
    name = "hello-buildroot-packages-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = 'python3 "$@"',
    args = ["$(source hello_archive_check.py)", "$(location :hello-buildroot-packages)"],
)

# The archive path runs %prep and emits both binary and source RPMs. It exists separately from the
# source-tree fixture to check release and dev compression through real RPM headers.
rpm.package(
    name = "hello-archive",
    distro = _DISTRO,
    package = "hello",
    spec = "hello/hello.spec",
    buildroot = _BUILDROOT,
    release = "1",
    source_date_epoch = 1754006400,
    subpackages = ["hello"],
)

box.sh_test(
    name = "hello-archive-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = 'python3 "$@"',
    args = ["$(source hello_archive_check.py)", "$(location :hello-archive)"],
)

rpm.package(
    name = "hello-parse-helper",
    distro = _DISTRO,
    package = "hello",
    spec = "hello/hello.spec",
    build_requires = ["jq"],
    buildroot = _BUILDROOT,
    release = "1",
    rpmbuild_options = ["--define=version_override %(jq -nr '\"1\"')"],
    source_date_epoch = 1754006400,
    subpackages = ["hello"],
)

box.sh_test(
    name = "hello-parse-helper-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = 'python3 "$@"',
    args = ["$(source hello_archive_check.py)", "$(location :hello-parse-helper)"],
)

# The explicit override keeps this source-tree fixture in dev mode without depending on the
# user's root config.
rpm.package(
    name = "hello-dev",
    distro = _DISTRO,
    package = "hello",
    buildroot = _BUILDROOT,
    dev = True,
    in_place_spec = "rpm/hello.spec",
    release = "1",
    source_date_epoch = 1754006400,
    source_tree = ":hello.source",
    subpackages = ["hello"],
)

box.sh_test(
    name = "hello-dev-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = 'python3 "$@"',
    args = [
        "$(source hello_dev_check.py)",
        "$(location :hello-dev)",
        "$(location :hello-dev[build])",
    ],
)

# The same checkout built for release from an in-tree dist-git rather than in dev mode.
# Like the archive build, and unlike the two dev builds, it reaches the shared cache.
rpm.package(
    name = "hello-tree",
    distro = _DISTRO,
    package = "hello",
    buildroot = _BUILDROOT,
    in_place_spec = "rpm/hello.spec",
    release = "1",
    source_date_epoch = 1754006400,
    source_tree = ":hello.source",
    subpackages = ["hello"],
)

box.sh_test(
    name = "hello-tree-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = 'python3 "$@"',
    args = [
        "$(source hello_tree_check.py)",
        "$(location :hello-tree)",
    ],
)

# hello-meson builds the same checkout with meson. ninja runs the compiler in the meson build directory, and
# the compiler then records the real path of the checkout. The test checks that the debugsource package still
# contains hello.c.
rpm.package(
    name = "hello-meson",
    distro = _DISTRO,
    package = "hello",
    buildroot = _BUILDROOT,
    in_place_spec = "rpm/hello-meson.spec",
    release = "1",
    source_date_epoch = 1754006400,
    source_tree = ":hello.source",
    subpackages = ["hello"],
)

box.sh_test(
    name = "hello-meson-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = 'rpm -qpl "$1"/hello-debugsource-*.rpm | grep -E "/hello\\.c$" > /dev/null',
    args = ["$(location :hello-meson)"],
)

# hello-pinned builds the same checkout with the spec and sources of the dist-git commit that
# rpm/packaging.json pins for fedora. The pin names a bundle in the project, so the fetch needs no network.
# The pinned spec doesn't produce hello-imported-only. The build reports the missing subpackage and doesn't
# fail.
rpm.package(
    name = "hello-pinned",
    distro = _DISTRO,
    package = "hello",
    buildroot = _BUILDROOT,
    in_place_packaging = "rpm/packaging.json",
    in_place_packaging_distro = "fedora",
    release = "1",
    source_date_epoch = 1754006400,
    source_tree = ":hello.source",
    subpackages = ["hello", "hello-imported-only"],
)

box.sh_test(
    name = "hello-pinned-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = 'python3 "$@"',
    args = [
        "$(source hello_pinned_check.py)",
        "$(location :hello-pinned)",
        "$(location :hello-pinned[hello])",
    ],
)

rpm.srpm(
    name = "hello.srpm",
    srpm = "hello.src.rpm",
    sub_targets = ["hello.spec"],
)

# hello-srpm rebuilds hello.src.rpm. The spec in the source rpm installs a Source file from it, and the spec
# lists jq in BuildRequires. The base buildroot doesn't contain jq, and the BUCK file doesn't list it. The
# header of the source rpm also lists a BuildRequires that no repository provides, and the spec doesn't.
# hello.src.rpm uses the rpm format 6, whose payload has stripped cpio headers.
rpm.package(
    name = "hello-srpm",
    distro = _DISTRO,
    package = "hello",
    spec = ":hello.srpm[hello.spec]",
    srcs = [":hello.srpm"],
    buildroot = _BUILDROOT,
    release = "1",
    source_date_epoch = 1754006400,
    subpackages = ["hello"],
)

box.sh_test(
    name = "hello-srpm-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = _CONTAINS,
    # The package contains built-with-jq only if the build installed jq, which only the spec in the source
    # rpm lists in BuildRequires.
    args = ["$(location :hello-srpm[hello])", "srpm-marker", "built-with-jq"],
)

# The committed directory hello-distgit replaces the fetch of the dist-git repository, so the revision is a
# placeholder and the build needs no network.
git.fetch(
    name = "hello-distgit.git",
    repo = "https://src.fedoraproject.org/rpms/hello.git",
    rev = "1111111111111111111111111111111111111111",
    sub_targets = ["hello.spec"],
)

# hello-distgit builds the spec of the dist-git repository with a Source file from the repository and one from
# srcs.
rpm.package(
    name = "hello-distgit",
    distro = _DISTRO,
    package = "hello",
    spec = ":hello-distgit.git[hello.spec]",
    srcs = ["extra-sources", ":hello-distgit.git"],
    buildroot = _BUILDROOT,
    release = "1",
    source_date_epoch = 1754006400,
    subpackages = ["hello"],
)

box.sh_test(
    name = "hello-distgit-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = _CONTAINS,
    args = ["$(location :hello-distgit[hello])", "local-note", "distgit-extra"],
)

# A derived package manager adds the locally built hello to the release's repositories. Fedora's
# repositories contain a newer hello. The solver picks the local hello only if the derived package manager
# gives the local repository its priority.
package.local_repository(
    name = "hello.repository",
    packages = [":hello-archive"],
)

package.manager(
    name = "hello.package-manager",
    base = "catalog//:fedora.rawhide.package-manager",
    additional_repositories = [":hello.repository"],
)

image.layer(
    name = "hello-image.layer",
    distro = _DISTRO,
    package_manager = ":hello.package-manager",
    packages = ["hello"],
)

image.archive(
    name = "hello-image",
    distro = _DISTRO,
    format = "tar",
    parent = ":hello-image.layer",
)

box.sh_test(
    name = "hello-image-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'tar -tf "$1" | grep -E "^(\\./)?usr/share/tine-package/archive$" > /dev/null',
    args = ["$(location :hello-image)"],
    distro = _DISTRO,
)
