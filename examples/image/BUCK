"""Image construction smoke targets.

Every image here is declared once and built for each release in `catalog//:releases.bzl`. What
varies is the package manager, chosen by a `select()` on the distribution constraint, and the
package sets that manager resolves; the operations themselves are the same either way. No
distribution is the default, so what a build names is one of the per-distribution aliases each
image rule declares for itself.
"""

load("@tine//box:defs.bzl", "box")
load("@tine//distribution:defs.bzl", "distribution")
load("@tine//image:defs.bzl", "image")
load("@tine//platform:architecture.bzl", "architecture")
load("@tine//python:defs.bzl", "python")
load("@tine//tests:defs.bzl", "tests")
load(":expected.json", _expected = "value")

# The catalog lists the releases in catalog//:releases.bzl. A release added there also gets images
# here, and no target below names a release.
DISTRIBUTIONS = distribution.for_package()

# A test that checks only the Fedora images builds for Fedora, so that it runs in a box of the Fedora release.
_FEDORA = DISTRIBUTIONS["fedora"]["distribution"]

# A build artifact a command names through $(location), chrooted or not.
export_file(
    name = "marker.txt",
    src = "marker.txt",
)

export_file(
    name = "configure.sh",
    src = "configure.sh",
)

export_file(
    name = "configure.py",
    src = "configure.py",
)

export_file(
    name = "manifest_check.py",
    src = "manifest_check.py",
)

export_file(
    name = "reproducibility_check.py",
    src = "reproducibility_check.py",
)

# Minimal install + ordered-ops demo. `:demo` is both the tar result and a logical image.
image.archive(
    name = "demo",
    packages = ["bash", "coreutils"]
    # Some extra coverage for distribution.select().
    + distribution.select({
        "DEFAULT": [],
        "arch": ["archlinux-keyring"],
        "fedora": ["fedora-gpg-keys"],
    }),
    ops = [
        image.ops.run(["/usr/bin/mkdir", "-p", "/buildroot/etc/tine"]),
        image.ops.run(["/usr/bin/cp", "$(location :marker.txt)", "/buildroot/etc/tine/from-location"]),
        # image.ops.copy() takes a source directly, so it needs no $(location) around the label.
        image.ops.copy(":marker.txt", "/etc/tine/from-copy"),
        # A chrooted command runs with the image's own binaries. Buck's macro parser claims
        # `$(...)`, so the shell substitution is escaped.
        image.ops.run(["/usr/bin/bash", "-c", "echo built-by-\\$(echo tine) > /etc/tine/marker"], chroot = True),
        # A repository-owned script, run inside the image. The project is mounted there, so
        # `$(location)` names the script and its data exactly as it would outside.
        image.ops.run(
            [
                "/usr/bin/bash",
                "$(location :configure.sh)",
                "$(location :marker.txt)",
                "from-script-argument",
            ],
            chroot = True,
        ),
        # The same, in python, which this image does not install: the interpreter is Buck's own.
        image.ops.python(["$(location :configure.py)", "$(location :marker.txt)", "from-python-argument"], chroot = True),
        # Unchrooted, the same interpreter sees the image at /buildroot, like any box command.
        image.ops.python(["-c", "from pathlib import Path; Path('/buildroot/etc/tine/from-python-box').write_text('x\\n')"]),
        # Ensure we don't leak the /tine sandbox mount into image builds
        image.ops.run(["/usr/bin/test", "!", "-d", "/tine"], chroot = True),
    ],
    format = "tar",
)

# An image with a single layer.
image.archive(
    name = "base",
    packages = ["bash"],
    format = "tar",
)

# The child image adds one file and removes a file of its parent.
image.layer(
    name = "chained-base",
    packages = ["bash", "coreutils"],
    ops = [
        image.ops.write_file("/etc/tine/from-base-kept", "base"),
        image.ops.write_file("/etc/tine/from-base-gone", "base"),
    ],
)

image.layer(
    name = "chained-child.layer",
    parent = ":chained-base",
    ops = [
        image.ops.write_file("/etc/tine/from-child", "child"),
        image.ops.remove("/etc/tine/from-base-gone"),
    ],
)

image.archive(
    name = "chained",
    parent = ":chained-child.layer",
    format = "tar",
)

# One layer installs packages and runs commands.
image.layer(
    name = "layered-install-base",
    packages = ["bash"],
    ops = [
        image.ops.run(["/usr/bin/bash", "-c", "echo base > /etc/from-base-install"], chroot = True),
    ],
)

image.layer(
    name = "layered-install.layer",
    parent = ":layered-install-base",
    packages = ["coreutils"],
    ops = [
        image.ops.run(["/usr/bin/bash", "-c", "ls /usr/bin/ls > /etc/from-child-install"], chroot = True),
    ],
)

image.archive(
    name = "layered-install",
    parent = ":layered-install.layer",
    format = "tar",
)

# Bootable GPT image; `buck run :boot-demo-vm` starts it with the box's vmspawn stack.
# Supply-chain and format subtargets such as `:boot-demo[sbom]` and `:boot-demo[qcow2]` build on demand.
# The version stamps os-release, partition labels, and the UKI and disk file names. A product names
# one here, or asks for a git-derived one with `version = "auto:1.4.2"`, which needs a build through
# `bin/tine` (see "Image versioning" in images.md); this demo has nothing to version.
image.disk(
    name = "boot-demo",
    definitions = image.DEFAULT_USR_VERITY_PARTITIONS,
    version = "unversioned",
    # The release names what a bootable system of its own family needs, so this stays symbolic.
    # The composition generates the databases those packages only describe, hwdb's among them.
    package_sets = ["bootable"],
    packages = ["grep", "less"]
    # Microcode is a package like any other; the UKI driver packs whatever vendor blobs the image
    # ends up shipping. Only x86 has any, and only x86 mirrors carry the packages.
    + architecture.select({
        "arm64": [],
        "x86_64": distribution.select({
            "DEFAULT": [],
            "arch": ["amd-ucode", "intel-ucode"],
            "fedora": ["amd-ucode-firmware", "microcode_ctl"],
        }),
    })
    # Only Arch's systemd package contains portablectl.
    + distribution.select({"DEFAULT": ["systemd-container"], "arch": []}),
    ops = [
        # systemd-confext mounts /etc read-only by default. This image writes /etc at boot, and
        # login fails with "PAM failure, aborting" once a confext is merged.
        image.ops.write_file("/usr/lib/systemd/confext.conf.d/10-mutable.conf", "[ConfExt]\nMutable=ephemeral\n"),
        # The ESP partition of the layout copies /boot of the image. The disk therefore contains
        # this file on its ESP.
        image.ops.copy(":demo[sbom][spdx]", "/boot/metadata/demo.spdx.json"),
    ],
    profiles = [
        image.uki_profile(
            id = "debug",
            title = "Boot with debug logs enabled",
            cmdline = ["debug", "systemd.log_level=debug", "systemd.journald.forward_to_console=1"],
        ),
    ],
    # An absolute path names a BMP the image itself ships, here the one Arch's systemd package
    # installs; the other distributions ship no BMP and embed none.
    splash = distribution.select({"DEFAULT": None, "arch": "/usr/share/systemd/bootctl/splash-arch.bmp"}),
    # A shipped appliance has no terminal to read a man page on.
    install_docs = False,
    # Ship the qcow2 with free space past its partitions, so a VM booting it can claim it without
    # resizing the disk first. This image boots from tmpfs, so nothing here consumes it; a real
    # appliance creates a root partition in it on first boot.
    virtual_size = "2G",
)

image.vm(
    name = "boot-demo-vm",
    autologin = "root",
    # A run-only kernel command line argument: the UKI carries a fixed one, so this can only arrive
    # through the channel vmspawn picks for its trailing arguments. The smoke asserts it landed.
    cmdline_extra = ["tine.smoke=1"],
    credentials = {
        "firstboot.locale": "C.UTF-8",
        "firstboot.timezone": "UTC",
    },
    image = ":boot-demo",
    extensions = [":demo-confext", ":demo-ext"],
    portables = [":demo-portable", ":demo-portable-ext"],
)

# Boot smoke test: drives :boot-demo-vm's console over a pty (via the shared tine driver),
# asserts the system settles, then powers off. `buck test` runs it, `buck run` boots it by hand.
tests.vm_smoke(
    name = "boot-demo-vm-smoke",
    vm = ":boot-demo-vm",
    checks = [
        # The distribution that booted is the one that was asked for. A select reaches here through
        # the alias the macro declares, which configures this target too. This reads the file the
        # build produced rather than the `/etc` symlink to it: a `/usr`-only disk boots with a
        # volatile root, and whether anything recreates that symlink is a property of the
        # distribution's own systemd rather than of the image.
        # Each family's os-release ID is the family's name.
        distribution.select({name: "grep -q '^ID={}$' /usr/lib/os-release".format(name) for name in distribution.FAMILIES}),
        "bootctl | grep -F 'Secure Boot: disabled (setup)'",
        # The build compiled the hardware database into /usr, which is read-only here, so a guest
        # that has it got it from the build rather than from a boot-time regeneration.
        "test -s /usr/lib/udev/hwdb.bin",
        # The runner's cmdline_extra reached the kernel the UKI booted.
        "grep -q tine.smoke=1 /proc/cmdline",
        # The initrd carries networkd for IMDS, which is inert on a non-cloud VM.
        '[ -z "$(journalctl -b -q _RUNTIME_SCOPE=initrd _SYSTEMD_UNIT=systemd-networkd.service)" ]',
        # systemd-sysext and systemd-confext merged the extensions the runner binds in at boot.
        "test -x /usr/bin/zsh",
        "test -f /etc/tine/from-confext",
        "touch /etc/tine/written-after-merge",
        # portabled checks the extension-release files of demo-portable-ext against the os-release
        # of demo-portable.
        "portablectl attach --now --runtime --extension demo-portable-ext demo-portable",
        "portablectl is-attached --extension demo-portable-ext demo-portable",
        "systemctl is-active demo-portable.service",
        # Without demo-portable-ext, demo-portable.service fails. This shows that the files came
        # from the extension.
        "portablectl detach --now --runtime --extension demo-portable-ext demo-portable",
        "portablectl attach --runtime demo-portable",
        "! systemctl start demo-portable.service",
    ],
)

# The qcow2 and vmdk describe a disk of the image's virtual_size with the raw's content, while the raw stays
# as small as its partitions.
box.sh_test(
    name = "virtual-size-test",
    labels = ["image"],
    box = "tine//distribution:tools.box",
    script = """
raw=$1
shift
test "$(stat -c %s "$raw")" -lt $((900 << 20))
for disk in "$@"; do
    test "$(qemu-img info --output=json "$disk" | python3 -c 'import json, sys; print(json.load(sys.stdin)["virtual-size"])')" = 2147483648
    qemu-img compare -q -f raw "$raw" "$disk"
done
""",
    args = ["$(location :boot-demo.fedora)", "$(location :boot-demo.fedora[qcow2])", "$(location :boot-demo.fedora[vmdk])"],
    distro = _FEDORA,
)

# The AMI parameters register the disk for the image's architecture with a root volume of its virtual_size.
box.sh_test(
    name = "ami-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = """
python3 -c '
import json, sys
register = json.load(open(sys.argv[1]))
assert register["Architecture"] == sys.argv[2], register
assert register["BlockDeviceMappings"][0]["Ebs"]["VolumeSize"] == 2, register
' "$@"
""",
    args = ["$(location :boot-demo.fedora[ami])"] + architecture.select({name: [spellings.ec2] for name, spellings in architecture.ARCHITECTURES.items()}),
    distro = _FEDORA,
)

# data-disk has no ESP partition, so image.disk builds it without systemd-boot, UKIs or an initrd.
image.disk(
    name = "data-disk",
    packages = ["bash"],
    definitions = [
        image.partition(
            type = "root",
            filesystem = "ext4",
            copy_files = ["/"],
            minimize = "guess",
        ),
    ],
)

box.sh_test(
    name = "data-disk-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "data-disk-test.sh",
    args = ["$(location :data-disk.fedora)"],
    distro = _FEDORA,
)

# demo-ext extends boot-demo. The DDI contains only the files that demo-ext adds to boot-demo,
# and its extension-release file pins the exact build of boot-demo. `boot-demo-vm` binds
# it into /var/lib/extensions.
image.sysext(
    name = "demo-ext",
    parent = ":boot-demo",
    packages = ["zsh"],
    install_docs = False,
    # install a file from source tree; covers reproducibility check under varying umasks
    ops = [image.ops.copy("from-source.txt", "/usr/lib/tine/from-source")],
)

# demo-confext contains only /etc. Its extension-release file pins the exact build of boot-demo,
# as the one of demo-ext does.
image.confext(
    name = "demo-confext",
    parent = ":boot-demo",
    ops = [image.ops.write_file("/etc/tine/from-confext", "confext\n")],
)

# portablectl attaches only the units whose names start with the image name, so the service is
# called demo-portable.service.
image.portable(
    name = "demo-portable",
    packages = ["bash", "coreutils"],
    install_docs = False,
    # demo-portable-ext must not contain this directory, because only demo-portable declares it.
    tmpfiles = ["d /etc/tine/from-parent-tmpfiles 0755 - -"],
    ops = [image.ops.copy("demo-portable.service", "/usr/lib/systemd/system/demo-portable.service")],
)

# demo-portable.service fails unless it finds the files that demo-portable-ext adds to /usr and
# /etc. systemd merges only /usr, /opt and /etc of an extension, so the extension DDI does not
# contain the file that demo-portable-ext writes to /var. A portable service that needs a directory
# under /var must find it in the portable image.
image.extension(
    name = "demo-portable-ext",
    parent = ":demo-portable",
    classes = ["sysext", "confext"],
    scope = ["portable"],
    ops = [
        image.ops.write_file("/usr/lib/tine/from-portable-ext", "usr\n"),
        image.ops.write_file("/etc/tine/from-portable-ext", "etc\n"),
        image.ops.write_file("/var/lib/tine/from-portable-ext", "var\n"),
    ],
)

_PRELOADED_EXTENSIONS = [":demo-confext", ":demo-ext"]

_PRELOADED_PORTABLES = [":demo-portable", ":demo-portable-ext"]

# boot-demo with the demo DDIs on its ESP, where systemd-sysupdate would update them. Nothing merges or
# attaches them at boot yet: whoever instantiates the disk does that.
image.ddi_preloaded_disk(
    name = "boot-demo-preloaded",
    base = ":boot-demo",
    extensions = _PRELOADED_EXTENSIONS,
    portables = _PRELOADED_PORTABLES,
)

# boot-demo's published raw.zst and AMI parameters, the way a project that builds on a release of it
# imports them, and the same DDIs on its ESP.
image.imported_disk(
    name = "boot-demo-imported",
    ami = ":boot-demo[ami]",
    disk = ":boot-demo[raw.zst]",
    # As boot-demo's own, which a release would publish beside the disk.
    virtual_size = "2G",
)

image.ddi_preloaded_disk(
    name = "boot-demo-imported-preloaded",
    base = ":boot-demo-imported",
    extensions = _PRELOADED_EXTENSIONS,
    portables = _PRELOADED_PORTABLES,
)

# The preloaded disk defaults to the virtual_size of the imported one.
box.sh_test(
    name = "imported-virtual-size-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = """test "$(qemu-img info --output=json "$1" | jq '."virtual-size"')" = 2147483648""",
    args = ["$(location :boot-demo-imported-preloaded.fedora[qcow2])"],
    distro = _FEDORA,
)

image.vm(
    name = "boot-demo-preloaded-vm",
    autologin = "root",
    credentials = {
        "firstboot.locale": "C.UTF-8",
        "firstboot.timezone": "UTC",
    },
    image = ":boot-demo-preloaded",
)

# The checks activate the DDIs on the ESP the way an instance would, see "image.ddi_preloaded_disk" in images.md.
# The ESP carries one version of each, so the links can name the .raw.v directories.
tests.vm_smoke(
    name = "boot-demo-preloaded-vm-smoke",
    vm = ":boot-demo-preloaded-vm",
    checks = [
        # The disk has boot-demo's virtual_size
        'test "$(lsblk --nodeps --noheadings --bytes --output SIZE /dev/vda)" = 2147483648',
        # The ESP is where systemd-gpt-auto-generator mounts it, which is /boot on this image.
        'test -d "$(bootctl --print-esp-path)/extensions"',
        "mkdir -p /run/extensions /run/confexts",
        'ln -s "$(bootctl --print-esp-path)/extensions/demo-ext.raw.v" /run/extensions/',
        'ln -s "$(bootctl --print-esp-path)/extensions/demo-confext.raw.v" /run/confexts/',
        "systemd-sysext refresh",
        "systemd-confext refresh",
        # systemd-vpick picked each newest version out of its directory, and the extension-release of
        # each matches boot-demo.
        "test -x /usr/bin/zsh",
        "test -f /etc/tine/from-confext",
        'portablectl attach --now --runtime --extension "$(bootctl --print-esp-path)/portables/demo-portable-ext.raw.v" "$(bootctl --print-esp-path)/portables/demo-portable.raw.v"',
        "systemctl is-active demo-portable.service",
    ],
)

# The preloaded disk registers with the AMI parameters of boot-demo, under its own name.
box.sh_test(
    name = "preloaded-ami-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = """
python3 -c '
import json, sys
base, preloaded = (json.load(open(path)) for path in sys.argv[1:])
assert preloaded["Name"] == preloaded["Description"] == "boot-demo-preloaded", preloaded
names = ("Name", "Description")
assert {k: v for k, v in preloaded.items() if k not in names} == {k: v for k, v in base.items() if k not in names}, (base, preloaded)
' "$@"
""",
    args = ["$(location :boot-demo.fedora[ami])", "$(location :boot-demo-preloaded.fedora[ami])"],
    distro = _FEDORA,
)

# Preloading the imported raw.zst writes the same disk as preloading boot-demo itself, and registers it
# with the same AMI parameters, under its own name.
box.sh_test(
    name = "imported-disk-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = """
python3 -c '
import hashlib, json, sys
disk, imported_disk, ami, imported_ami = sys.argv[1:]
digests = [hashlib.file_digest(open(path, "rb"), "sha256").hexdigest() for path in (disk, imported_disk)]
assert digests[0] == digests[1], digests
ami, imported_ami = json.load(open(ami)), json.load(open(imported_ami))
assert imported_ami["Name"] == "boot-demo-imported-preloaded", imported_ami
names = ("Name", "Description")
assert {k: v for k, v in ami.items() if k not in names} == {k: v for k, v in imported_ami.items() if k not in names}
' "$@"
""",
    args = [
        "$(location :boot-demo-preloaded.fedora)",
        "$(location :boot-demo-imported-preloaded.fedora)",
        "$(location :boot-demo-preloaded.fedora[ami])",
        "$(location :boot-demo-imported-preloaded.fedora[ami])",
    ],
    distro = _FEDORA,
)

# A file tree that differs per distribution is one copy whose source is a select, rather than a
# target per distribution and an alias choosing between them. A distribution the select names no
# tree for gets `None`, which copies nothing; only arch ships one so every other exercises that.
image.layer(
    name = "tree.layer",
    parent = ":base",
    ops = [
        image.ops.copy("tree/os", "/"),
        image.ops.copy(distribution.select({"DEFAULT": None, "arch": "tree/os.arch"}), "/"),
    ],
)

image.archive(
    name = "tree",
    parent = ":tree.layer",
    format = "tar",
)

# The test runs once per release of the catalog. It checks that the select picks the arch tree for
# Arch and no tree for the other releases.
box.sh_test(
    name = "tree-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "tree-test.sh",
    args = ["$(location :tree)"] + distribution.select({d["release"]: [name if name == "arch" else "none"] for name, d in DISTRIBUTIONS.items()}),
)

# The UKI's module selection still carries what the demo image boots through. The smoke proves the
# same thing by booting; this pins it against the real kernel without a VM, so a change to the
# default list that drops one fails here with the module named. Only modules Fedora builds as
# modules: it links dm-mod, ext4, virtio_blk, virtio_pci, ahci and sd_mod into the kernel.
box.sh_test(
    name = "uki-modules-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "@tine//tests:contains.sh",
    args = ["$(location :boot-demo.fedora[uki][modules])"]
    + [
        '"path": ".*/{}\\.ko'.format(module)
        for module in ["erofs", "dm-verity", "ena", "loop", "overlay", "nvme", "vfat", "virtio_scsi", "virtio_net", "virtiofs"]
    ],
    distro = _FEDORA,
)

# The file manifest is what tells a consumer which paths an image ships, so its framing and its
# view of a real tree are part of the contract rather than an implementation detail. The checker
# is a python file of its own rather than a script the test inlines, so the linters see it.
box.sh_test(
    name = "manifest-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'python3 "$@"',
    args = [
        "$(location :manifest_check.py)",
        "$(location :demo.fedora[manifest])",
    ],
    distro = _FEDORA,
)

box.sh_test(
