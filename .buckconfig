# Standalone root cell. Consuming projects supply their own; see README.md.

[cells]
# Named `tine`, not `root`, so same-cell labels match those in a consuming project. This must be the
# cell's real name rather than an alias because labels retain the name of the cell they resolve to.
tine = .
# A project replaces tine's catalog with its own by declaring a cell of this name.
catalog = catalog
prelude = prelude
none = none

[cell_aliases]
config = prelude
# Keep the toolchain attached to the tine cell when a project points that cell at this checkout.
toolchains = tine
# Satisfy the bundled prelude's internal platform alias.
fbsource = none

[external_cells]
prelude = bundled

[parser]
target_platform_detector_spec = target:tine//...->tine//platform:default target:catalog//...->tine//platform:default

[build]
execution_platforms = tine//platform:default

[project]
# Completion can start Buck before the generated .buckconfig.local exists.
ignore = **/.git, **/.jj, **/.hg, **/.svn

[buck2]
materializations = deferred
sqlite_materializer_state = true
# Persist the dep-file cache too, so local actions still hit it after a daemon restart.
sqlite_dep_file_state = true
defer_write_actions = true

[buck2_resource_control]
# A host without a systemd user manager, such as a container, runs the daemon without cgroups.
status = if_available
enable_suspension = true
# Killing a suspended action throws away its work, and a long action such as an RPM build then starts
# over. A frozen action keeps its work, but the kernel frees its memory only by swapping it out.
preferred_action_suspend_strategy = cgroup_freeze
