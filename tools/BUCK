"""Pinned tool binaries and development commands fetched by Buck."""

load("//:tine.lock.json", _pins = "value")
load("//box:defs.bzl", "box")
load("//distribution:defs.bzl", "distribution")
load("//http:defs.bzl", "http")
load("//python:defs.bzl", "python")

_RELEASE = "catalog//:default.release"

# Every pinned tool is declared in //:tine.lock.json and refreshed by `tine bump` (see docs/user/images.md). Buck
# fetches and verifies every tool except Buck2, which `bin/tine` fetches.

# Relocatable bootstrap Python; 3.14 provides stdlib zstd for RPM payloads.
# PUBLIC: the toolchain reaching it is `tine//:python_bootstrap`, and a project that declares a
# `toolchains` cell of its own rather than aliasing this one forwards to that target from outside.
http.tool(
    name = "python3",
    args = ["-B"],
    path = "bin/python3",
    spec = _pins["python3"],
    visibility = ["PUBLIC"],
)

# The Starlark formatter is published as a bare zstd-compressed binary in the releases of Buck2.
# tine.lock.json pins the formatter and Buck2, so one `tine bump` run keeps them on the same release.
http.tool(
    name = "starlark-fmt",
    compressed = True,
    spec = _pins["starlark-fmt"],
)

# Python formatter + linter (static musl builds).
http.tool(
    name = "ruff",
    path = "ruff",
    spec = _pins["ruff"],
)

# Python type checker (static musl builds).
http.tool(
    name = "ty",
    path = "ty",
    spec = _pins["ty"],
    visibility = ["PUBLIC"],
)

# SBOM generator (static release binary; not packaged in Fedora). Scans an assembled image tree for the
# package database, ELF-bundled modules, and other package metadata.
http.tool(
    name = "syft",
    path = "syft",
    spec = _pins["syft"],
    visibility = ["PUBLIC"],
)

# Cargo wrapper that embeds the crate graph in every binary it builds, so SBOM scanners can report
# what a from-source Rust binary contains. Fedora does not package it, and we
# can't build it from source yet. https://crates.io/crates/cargo-auditable
http.tool(
    name = "cargo-auditable",
    path = "cargo-auditable",
    spec = _pins["cargo-auditable"],
    visibility = ["PUBLIC"],
)

# S3 server with a plain-HTTP read side, for the remote cache's integration tests. Not packaged in Fedora.
http.tool(
    name = "seaweedfs",
    path = "weed",
    spec = _pins["seaweedfs"],
    visibility = [
        "tine//remote_cache/...",
        "tine//tests/...",
    ],
)

# tine's dev environment for importer and its unit tests. Used by every `box_python_test` suite
# (hermetic), `tine//tools:importer` (relaxed), and anyone entering it as a box.
# The dev box layers over the tools box, so it installs only its own packages. A test of an image runs in
# the dev box of the image's release. No image depends on the dev box, so a change to its packages rebuilds
# no image.
# The dev box contains the package tooling of its own family only. The tests of the importer and of
# package_system/rpm skip themselves in a dev box without rpmbuild. The plan test of package_system/pacman
# skips itself in a dev box without libalpm.
box.new(
    name = "dev.box",
    packages = [
        "coreutils",
        "gawk",
        # for the assertions over a release's description
        "jq",
        # for the assertions over generated certificates
        "openssl",
        # the license headers lint, see the `reuse` alias below
        "reuse",
        "sed",
    ]
    + distribution.select({
        "arch": [
            "diffutils",
            "git",
            "gnupg",
            "sequoia-sqv",
            "tar",
            "util-linux",
        ],
        "debian": [
            "fdisk",
            "git",
            "gnupg",
            # The tools box resolves awk to mawk, and the dev box installs gawk too. Without mawk in
            # this list, the dev box resolves awk to gawk alone and can't layer over the tools box.
            "mawk",
            "sqv",
        ],
        "fedora": [
            # `importer srpm` runs dist-git-client.
            "dist-git-client",
            "git-core",
            "gnupg2",
            "python3-createrepo_c",
            "python3-libdnf5",
            "python3-rpm",
            "rpm-build",
            # The tests of package_system/rpm sign the packages that they build.
            "rpm-sign",
            "sequoia-sqv",
            "util-linux",
        ],
    }),
    parent = "tine//distribution:tools.box",
    release = distribution.release_target("release"),
    visibility = ["PUBLIC"],
)

# Runtime driver for the source-tree commands below.
python.binary(
    name = "dev",
    main = "dev.py",
    deps = ["//:util"],
)

box.python_test(
    name = "dev-test",
    box = ":dev.box",
    srcs = [
        "dev.py",
        "dev_test.py",
    ],
    env = {
        "TY_TEST_BINARY": "$(location_exec :ty)",
        "TY_TEST_PYTHON": "$(location_exec :python3)",
    },
    deps = ["//:util"],
)

python.binary(
    name = "catalog",
    main = "catalog.py",
    deps = ["//:util"],
)

# The dev box carries gpg, which the armoring test reads its output back with.
box.python_test(
    name = "catalog-test",
    box = ":dev.box",
    srcs = ["catalog.py", "catalog_test.py"],
    deps = ["//:util"],
)

# PUBLIC: CI's automatic changes (.github/workflows/bump.yml, used by consuming project as well). A
# runner invokes it as a plain script with the host python, before Buck has fetched anything;
# this target is what type checks it.
python.binary(
    name = "bot-pr",
    main = "bot_pr.py",
    visibility = ["PUBLIC"],
)

# Debian testing has no gh package, so setup-deploy-key runs GitHub's own build of gh in every box.
http.tool(
    name = "gh",
    path = "bin/gh",
    spec = _pins["gh"],
)

# setup-deploy-key gets its own box, as it runs rarely.
box.new(
    name = "deploy-key.box",
    # gh runs git to find the repository of the checkout, and it verifies GitHub's certificate against the
    # box's CA certificates. The openssh packages contain ssh-keygen.
    packages = ["ca-certificates"]
    + distribution.select({
        "arch": ["git", "openssh"],
        "debian": ["git", "openssh-client"],
        "fedora": ["git-core", "openssh-clients"],
    }),
    release = _RELEASE,
)

python.binary(
    name = "setup-deploy-key-driver",
    box = ":deploy-key.box",
    main = "setup_deploy_key.py",
)

# PUBLIC: run by repository admin once. Relaxed, it uses the host's gh login and checkout.
command_alias(
    name = "setup-deploy-key",
    args = ["--gh", "$(location_exec :gh)"],
    exe = ":setup-deploy-key-driver",
    visibility = ["PUBLIC"],
)

# The AWS tools are big and rarely needed, so they get a box of their own. A disk's AMI subtarget writes and
# imports the AMI in the aws box of the disk's release.
box.new(
    name = "aws.box",
    # uefi-data-test in examples/image-secureboot runs mktemp from coreutils. Fedora installs coreutils as a
    # dependency of the other packages, and Arch does not.
    packages = ["coreutils"]
    # The virt-firmware packages contain virt-fw-vars, which writes an AMI's UEFI variable store.
    + distribution.select({
        "arch": ["aws-cli-v2", "virt-firmware"],
        "debian": ["awscli", "python3-virt-firmware"],
        "fedora": ["awscli2", "python3-virt-firmware"],
    }),
    release = distribution.release_target("release"),
    visibility = ["PUBLIC"],
)

# PUBLIC: the AWS CLI, relaxed so that it logs in to and reads the host's ~/.aws, e.g.
# `buck run tine//tools:aws -- login`.
command_alias(
    name = "aws",
    args = ["aws"],
    # The box has no pager, neither aws' `less` default nor the host's $PAGER; aws breaks without it.
    env = {"AWS_PAGER": ""},
    exe = ":aws.box",
    visibility = ["PUBLIC"],
)

_SOURCE_ARGS = [
    "--starlark-fmt",
    "$(location_exec :starlark-fmt)",
    "--starlark-fmt-config",
    "$(source starlark-fmt.json)",
    "--ruff",
    "$(location_exec :ruff)",
]

command_alias(
    name = "lint",
    args = ["lint"] + _SOURCE_ARGS,
    exe = ":dev",
)

# check = lint + `buck test tine//...`. The suites are test targets, not build artifacts, so they
# cannot come in as `resources`; the driver nests the test run instead.
command_alias(
    name = "check",
    args = ["check"] + _SOURCE_ARGS,
    exe = ":dev",
)

# REUSE compliance: every file's SPDX header, plus what REUSE.toml covers instead. Nobody ships a
# standalone binary for it, so the lint nests this alias rather than taking a pinned tool by path.
command_alias(
    name = "reuse",
    args = ["reuse"],
    exe = ":dev.box",
)

# The rpm importer (see docs/user/importer.md): its verbs need the pinned rpm toolchain plus the
# host's git identity, network, and cwd, so it runs through the dev box's relaxed entry.
command_alias(
    name = "importer",
    args = ["$(source importer.py)"],
    exe = ":dev.box",
)

# PKCS#11 signing tokens for testing (ci.sh's secureboot-pkcs11 step): a software TPM, the
# production tpm2-pkcs11 module on top, and the p11-kit server exposing its tokens to build
# sandboxes over a socket. See tools/signing-server.
box.new(
    name = "swtpm-signing.box",
    # swtpm has no resource manager, so tools/signing-server runs tpm2-abrmd on a private D-Bus. The
    # ci.sh step runs ukify to read a UKI section back out. tpm2_ptool runs tpm2-tools binaries, but its
    # package does not depend on tpm2-tools.
    packages = [
        "bash",
        "coreutils",
        "openssl",
        "pkcs11-provider",
        "swtpm",
        "systemd-ukify",
        "tpm2-abrmd",
        "tpm2-tools",
    ]
    + distribution.select({
        "arch": [
            "dbus",
            "p11-kit",
            "tpm2-pkcs11",
            "tpm2-pkcs11-tools",
        ],
        # Debian packages each TCTI of tpm2-tss on its own. tpm2-abrmd reaches swtpm through the swtpm TCTI,
        # and tpm2-tools and tpm2-pkcs11 reach tpm2-abrmd through the tabrmd TCTI.
        "debian": [
            "dbus-daemon",
            "libtpm2-pkcs11-1",
            "libtpm2-pkcs11-tools",
            "libtss2-tcti-swtpm0t64",
            "libtss2-tcti-tabrmd0",
            "p11-kit",
        ],
        "fedora": [
            "dbus-daemon",
            "p11-kit-server",
            "tpm2-pkcs11",
            "tpm2-pkcs11-tools",
        ],
    }),
    release = _RELEASE,
    visibility = ["PUBLIC"],
)

command_alias(
    name = "signing-server",
    args = ["$(source signing-server)"],
    exe = ":swtpm-signing.box",
)

box.python_test(
    name = "importer-test",
    box = ":dev.box",
    srcs = [
        "importer.py",
        "importer_test.py",
    ],
)

