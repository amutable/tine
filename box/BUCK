"""Pinned execution-environment launcher."""

load("//python:defs.bzl", "python")
load(":defs.bzl", "box")

python.library(
    name = "isolation",
    srcs = ["isolation.py"],
    visibility = ["tine//..."],
)

python.binary(
    name = "sandbox",
    main = "sandbox.py",
    deps = [":isolation"],
    visibility = ["PUBLIC"],
)

box.python_test(
    name = "test",
    box = "//tools:dev.box",
    srcs = [
        "isolation_test.py",
        "sandbox.py",
        "sandbox_test.py",
    ],
    deps = [":isolation"],
)
