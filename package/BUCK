python.test(
    name = "test",
    # installer_test runs systemd-tmpfiles, which only the tools box contains.
    box = "tine//distribution:tools.box",
    srcs = ["installer_test.py", "snapshotter_test.py", "transaction_test.py"],
    deps = [":installer", ":snapshotter", ":transaction"],
)

# The driver runs in the box with network access. It reads a source checkout's packaging pin and writes the
# tree of the pinned commit.
python.binary(name = "packaging", main = "packaging.py", deps = ["//:specs", "//:util"], visibility = ["PUBLIC"])

python.test(
    name = "packaging-test",
    # The test creates git repositories, and the dev box contains git.
    box = "tine//tools:dev.box",
    srcs = ["packaging.py", "packaging_test.py"],
    deps = ["//:specs", "//:util"],
