    main = "ami_import.py",
    visibility = ["PUBLIC"],
)

# Nothing satisfies this value, so a target requiring it cannot be built. A key whose section has no
# token requires it, which keeps it out of `//...` and makes an image that signs with it fail naming
# this target. `prelude//:none` would do the same without naming a reason.
constraint_setting(name = "signing-configuration")

constraint_value(
    name = "no-signing-token-configured",
    constraint_setting = ":signing-configuration",
    visibility = ["PUBLIC"],
)
