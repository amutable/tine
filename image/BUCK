"""Logical images, their compositions and output formats, and the drivers that build them."""

load("@prelude//:rules.bzl", "constraint_setting", "constraint_value")
load("//python:defs.bzl", "python")
load(":image.bzl", "image_tools")

# The one bundle every image rule resolves its drivers through.
image_tools(
    name = "tools",
    archive = ":archive",
    artifacts = ":artifacts",
    boot = ":boot",
    convert = ":convert",
    ddi = ":ddi",
    layer = ":layer",
    manifest = ":manifest",
    preload = ":preload",
    python = "//tools:python3",
    sbom = ":sbom",
    syft = "//tools:syft",
    uki = ":uki",
    visibility = ["PUBLIC"],
)

